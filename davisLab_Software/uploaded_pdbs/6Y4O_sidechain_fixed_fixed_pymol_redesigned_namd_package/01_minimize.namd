# =====================================================================
# NAMD Configuration — Stage 1/4: restrained minimization
# Structure : 6Y4O_sidechain_fixed_fixed_pymol_redesigned   (explicit TIP3P solvent, CHARMM36)
# =====================================================================
structure            6Y4O_sidechain_fixed_fixed_pymol_redesigned_solvated.psf
parameters           par_all36_prot.prm
parameters           par_all36_cgenff.prm
parameters           toppar_water_ions.str
paratypecharmm       on

wrapAll              on
wrapWater            on
cellBasisVector1     68.760   0.000   0.000
cellBasisVector2     0.000   68.760   0.000
cellBasisVector3     0.000   0.000   68.760
cellOrigin           0.000   0.000   0.000

exclude              scaled1-4
1-4scaling           1.0
cutoff               12.0
switching            on
switchdist           10.0
pairlistdist         13.5
PME                  yes
PMEGridSpacing       1.0

rigidBonds           all
nonbondedFreq        1
fullElectFrequency   2
timestep             2.0

CUDASOAintegrate        on

coordinates          6Y4O_sidechain_fixed_fixed_pymol_redesigned_solvated.pdb
temperature          0

constraints           on
consexp                2
consref                restraint_k10.pdb
conskfile               restraint_k10.pdb
conskcol                B

outputName            01_minimize
outputEnergies        500
minimize              10000
